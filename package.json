{
  "name": "@antelopejs/file-storage-local",
  "version": "0.1.8",
  "description": "Local filesystem storage module for AntelopeJS, implementing the File Storage interface for development and single-instance deployments",
  "keywords": [
    "antelopejs",
    "file-storage",
    "filesystem",
    "local",
    "upload"
  ],
  "homepage": "https://github.com/AntelopeJS/interface-file-storage/tree/main/docs",
  "bugs": {
    "url": "https://github.com/AntelopeJS/file-storage-local/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/file-storage-local.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w -p playground",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.15 <1.0.0",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-file-storage": ">=0.1.4 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.16.0",
    "@antelopejs/tooling-configs": "^0.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-file-storage"
    ],
    "test": "src/test/antelope.test.ts"
  }
}
